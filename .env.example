# Loyollo — environment variable template (names only)
# Copy to `.env` and fill in values. Never commit real secrets.
# Canonical inventory: docs/deployment/env.md

# --- Next.js public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SSR / server — same URL/key as public pair if desired) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only; never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth email BFF (webhook + preview) ---
EMAIL_WEBHOOK_SECRET=

# --- Optional leftover Vite names (mapped in next.config.ts if NEXT_PUBLIC_* unset) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
