# Loyollo — environment variable template (names only)
# Copy to `.env` and fill in values. Never commit real secrets.
# Canonical inventory: docs/deployment/env.md

# --- Supabase (browser / Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SSR / server — same values as VITE pair) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only; never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Lovable email routes (legacy; withdraw per ADR-009) ---
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# --- Next.js public (migration; maps from VITE_* — see docs/deployment/env.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional / unused by app code (kept for local convenience) ---
# SUPABASE_PROJECT_ID=
# VITE_SUPABASE_PROJECT_ID=
