{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/assets/**/*.ts",
    "src/config/**/*.ts",
    "src/config/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/lib/navigation/**/*.ts",
    "src/lib/navigation/**/*.tsx",
    "src/lib/server/**/*.ts",
    "src/lib/server/**/*.tsx",
    "src/lib/client/**/*.ts",
    "src/lib/utils.ts",
    "src/lib/password.ts",
    "src/lib/plans.ts",
    "src/lib/notify-client.ts",
    "src/lib/asset-src.ts",
    "src/types/**/*.ts",
    "src/integrations/supabase/types.ts",
    "src/integrations/supabase/fetch.ts",
    "src/integrations/supabase/browser.ts",
    "src/integrations/supabase/server.ts",
    "src/integrations/supabase/admin.ts",
    "src/integrations/supabase/update-session.ts",
    "src/integrations/supabase/auth-client.ts",
    "src/proxy.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/routes", "src/routeTree.gen.ts"]
}
